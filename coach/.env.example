# ---- required ----
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# elevenlabs.io -> Developers -> API Keys (speech-to-text + text-to-speech)
ELEVENLABS_API_KEY=
# Hebrew voice. Erez (male, natural Israeli Hebrew). Alternatives:
#   Dalit MEuFCMd6dNJqQaLoEa8r (female), Ronit MaM4vxmqWxP0xmLoyjXl (female)
# Library voices may need to be added to "My Voices" in ElevenLabs first.
ELEVENLABS_VOICE_ID=AZzja2JCoYeMe9vDQBll
# A long random string; put the same value in pet/src/config.h
DEVICE_KEY=

# ---- optional: also chat with the coach in Telegram ----
# From @BotFather (a NEW bot). Leave empty to run watch-only.
COACH_BOT_TOKEN=
# Leave empty, send /start to the bot, it will tell you the number
OWNER_CHAT_ID=

# ---- optional tuning ----
DAILY_STEP_GOAL=8000
COACH_MORNING=07:30
COACH_EVENING=21:00
# The pet asks you to move after this many minutes without steps (09:00-21:00)
SIT_REMINDER_MINUTES=90
COACH_MODEL=claude-opus-5-5
COACH_EFFORT=medium
PORT=8080
